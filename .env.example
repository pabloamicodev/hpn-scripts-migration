# Shopify App credentials (from Partner Dashboard > App > Client credentials)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

# Production URL — set to your Vercel deployment URL once deployed
# e.g. https://hpn-scripts-migration.vercel.app
SHOPIFY_APP_URL=https://localhost:8081

# Stable app handle used to discover the deployed Function when no explicit ID is set
SHOPIFY_APP_HANDLE=hpn-scripts-migration

# Neon PostgreSQL — use the POOLED connection string from Neon dashboard
# (hostname ends in -pooler.neon.tech, port 6543)
# Required for Vercel deployment; optional for local dev
DATABASE_URL=

# After running "shopify app deploy", copy the Function ID from the CLI output
# e.g. gid://shopify/ShopifyFunction/01JABCDEF...
SHOPIFY_DISCOUNT_FUNCTION_ID=

# Set to "true" to enable the internal GraphQL console at /app/graphql
ENABLE_GRAPHQL_CONSOLE=false
