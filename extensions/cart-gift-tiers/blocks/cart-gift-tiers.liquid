{% comment %}
  Cart Gift Tiers — app embed (Theme Editor → App embeds).
  Renders no visible markup of its own; the JS asset below drives
  everything (subtotal watching, silent single-variant gifts, the
  multi-variant picker modal). Works on any Online Store 2.0 theme without
  theme code changes — that's the point of shipping this as an app embed
  instead of a snippet someone has to paste in.
{% endcomment %}
<div
  id="cart-gift-tiers-root"
  data-proxy-url="/apps/cart-gift-tiers"
  data-cart-url="{{ routes.cart_url }}"
  data-shop-currency="{{ shop.currency }}"
  hidden
></div>

<template id="cart-gift-tiers-modal-template">
  <dialog
    class="cart-gift-tiers-dialog"
    data-cart-gift-tiers-dialog
    aria-labelledby="cart-gift-tiers-modal-title"
    aria-describedby="cart-gift-tiers-modal-description"
  >
      <button
        type="button"
        class="cart-gift-tiers-close"
        data-cart-gift-tiers-close
        aria-label="Close"
      >&times;</button>
      <h2 id="cart-gift-tiers-modal-title" class="cart-gift-tiers-title">
        Choose your option
      </h2>
      <p id="cart-gift-tiers-modal-description" class="cart-gift-tiers-description"></p>
      <div class="cart-gift-tiers-options" data-cart-gift-tiers-options></div>
  </dialog>
</template>

<template id="cart-gift-tiers-option-template">
  <button type="button" class="cart-gift-tiers-option">
    <span class="cart-gift-tiers-option__media">
      <img class="cart-gift-tiers-option__image" alt="" width="320" height="320" loading="lazy">
    </span>
    <span class="cart-gift-tiers-option__content">
      <span class="cart-gift-tiers-option__variant-label"></span>
      <strong class="cart-gift-tiers-option__title"></strong>
      <span class="cart-gift-tiers-option__price-row">
        <s class="cart-gift-tiers-option__price"></s>
        <span class="cart-gift-tiers-option__free-badge">Free</span>
      </span>
    </span>
  </button>
</template>

{{ 'cart-gift-tiers.css' | asset_url | stylesheet_tag }}
<script src="{{ 'cart-gift-tiers.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Cart Gift Tiers",
  "target": "body",
  "settings": []
}
{% endschema %}
